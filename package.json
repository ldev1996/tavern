{
	"name": "tavern",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"apps/**",
		"packages/**"
	],
	"type": "module",
	"scripts": {
		"dev:web": "bun run --filter '@tavern/web' dev",
		"build:web": "bun run --filter '@tavern/web' build",
		"preview:web": "bun run --filter '@tavern/web' preview",
		"check": "bun run --workspaces check",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"typescript-eslint": "^8.72.1"
	}
}
